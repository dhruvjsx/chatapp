EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Get a free key at https://openrouter.ai/keys (no card required for :free models).
EXPO_PUBLIC_OPENROUTER_API_KEY=your-openrouter-api-key
# Any OpenRouter model id works; ":free" models cost nothing but are rate-limited
# and occasionally deprecated — check https://openrouter.ai/models?max_price=0
# for what's currently live if the default below stops responding.
EXPO_PUBLIC_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
